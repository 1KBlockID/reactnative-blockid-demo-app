# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

# BlockID SDK (1.30.40+) is distributed via SPM only.
# spm_dependency in the plugin podspec requires dynamic frameworks.
use_frameworks! :linkage => :dynamic

target 'BlockidpluginExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Fix fmt consteval errors with Xcode 16+
    xcode_version = (`xcrun xcodebuild -version 2>/dev/null`[/Xcode (\d+)/, 1] || "0").to_i
    if xcode_version >= 16
      fmt_base_header = "#{Pod::Config.instance.installation_root}/Pods/fmt/include/fmt/base.h"
      if File.exist?(fmt_base_header)
        content = File.read(fmt_base_header)
        patched = content.sub('#if FMT_USE_CONSTEVAL', '#if 0 // Patched: disable consteval for Xcode 16+ compatibility')
        if patched != content
          # fmt ships its headers read-only (mode 444) and CocoaPods re-extracts
          # them on every install, so grant write access before patching and put
          # the original mode back afterwards. Without this, File.write raises
          # EACCES and aborts the whole post_install hook.
          original_mode = File.stat(fmt_base_header).mode
          begin
            File.chmod(original_mode | 0o200, fmt_base_header)
            File.write(fmt_base_header, patched)
          ensure
            File.chmod(original_mode, fmt_base_header)
          end
        else
          Pod::UI.warn "fmt patch: expected pattern not found in #{fmt_base_header} — header may have changed"
        end
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        xcconfig_path = config.base_configuration_reference.real_path
        xcconfig = File.read(xcconfig_path)
        xcconfig_mod = xcconfig.gsub(/DT_TOOLCHAIN_DIR/, "TOOLCHAIN_DIR")
        File.open(xcconfig_path, "w") { |file| file << xcconfig_mod }
      end
    end

    # Add SPM package product dependencies to the app target so they are
    # linked and embedded at runtime (SPM packages in the Pods project are
    # not automatically embedded in the app bundle).
    spm_frameworks = ['BlockID', 'Alamofire', 'BigInt', 'CryptoSwift', 'OpenSSL', 'WalletCore']
    app_project = Xcodeproj::Project.open(File.join(__dir__, 'BlockidpluginExample.xcodeproj'))
    app_target = app_project.targets.find { |t| t.name == 'BlockidpluginExample' }
    if app_target
      modified = false
      pods_project = installer.pods_project

      # Requirement hashes can come from disk (string keys) or from the podspec
      # via spm_dependency (symbol keys), so normalise before comparing.
      normalize_req = lambda do |req|
        (req || {}).each_with_object({}) { |(k, v), h| h[k.to_s] = v.to_s }
      end

      pods_project.root_object.package_references.each do |pkg_ref|
        next unless pkg_ref.is_a?(Xcodeproj::Project::Object::XCRemoteSwiftPackageReference)

        # Sync the package reference itself FIRST, independently of whether its
        # products are already linked to the app target. The Pods project is
        # regenerated on every `pod install` and carries the version declared in
        # the plugin podspec, so it is the source of truth. Without the update
        # branch below, an SDK version bump never reaches the app project and
        # Xcode keeps resolving whatever was pinned on the first install.
        app_pkg = app_project.root_object.package_references.find do |p|
          p.is_a?(Xcodeproj::Project::Object::XCRemoteSwiftPackageReference) &&
            p.repositoryURL == pkg_ref.repositoryURL
        end

        if app_pkg.nil?
          app_pkg = app_project.new(Xcodeproj::Project::Object::XCRemoteSwiftPackageReference)
          app_pkg.repositoryURL = pkg_ref.repositoryURL
          app_pkg.requirement = pkg_ref.requirement
          app_project.root_object.package_references << app_pkg
          Pod::UI.puts "[SPM] app project: adding #{pkg_ref.repositoryURL} #{normalize_req.call(pkg_ref.requirement)}"
          modified = true
        elsif normalize_req.call(app_pkg.requirement) != normalize_req.call(pkg_ref.requirement)
          Pod::UI.puts "[SPM] app project: updating #{pkg_ref.repositoryURL} " \
            "#{normalize_req.call(app_pkg.requirement)} -> #{normalize_req.call(pkg_ref.requirement)}"
          app_pkg.requirement = pkg_ref.requirement
          modified = true
        end

        # Then link any products that are not on the app target yet, so they get
        # embedded in the app bundle.
        pods_project.targets.each do |pod_target|
          next unless pod_target.is_a?(Xcodeproj::Project::Object::PBXNativeTarget)
          next unless pod_target.respond_to?(:package_product_dependencies)

          pod_target.package_product_dependencies.each do |dep|
            next unless dep.package == pkg_ref
            next unless spm_frameworks.include?(dep.product_name)
            next if app_target.package_product_dependencies.any? { |d| d.product_name == dep.product_name }

            product_dep = app_project.new(Xcodeproj::Project::Object::XCSwiftPackageProductDependency)
            product_dep.product_name = dep.product_name
            product_dep.package = app_pkg
            app_target.package_product_dependencies << product_dep
            Pod::UI.puts "[SPM] app target: linking #{dep.product_name}"
            modified = true
          end
        end
      end

      app_project.save if modified
    end
  end
end
